# Mobile env (Expo). Copy to apps/mobile/.env
#
# localhost is fine for iOS Simulator. On Android emulator the app rewrites
# localhost → 10.0.2.2 automatically. Physical devices need your Mac's LAN IP:
#   EXPO_PUBLIC_API_URL=http://192.168.x.x:3000
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Dev/eval bootstrap login (optional):
# On sign-in, SEED email + any non-empty password uses the bootstrap bearer
# (same value as server AUTH_BOOTSTRAP_TOKEN; server needs AUTH_ALLOW_BOOTSTRAP=true).
# Enabled automatically in __DEV__ when the token is set. For release builds, also set:
#   EXPO_PUBLIC_ALLOW_BOOTSTRAP_LOGIN=1
# EXPO_PUBLIC_SEED_USER_EMAIL=owner@yaadora.local
# EXPO_PUBLIC_AUTH_BOOTSTRAP_TOKEN=dev-token
